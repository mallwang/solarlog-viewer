# SolarLog device data mirrors (live-overwritten `web/data/`, frozen `web/hist/`) — served over
# the dev-server proxy (bs-config.cjs) at runtime and synced from the FTP archive via the
# sync-ftp skill / scripts/ftp-sync.js; not meant to be versioned.
/web/data/
/web/hist/

# React Component Preview
previewConfig.json

# FTP sync credentials and generated diff report (scripts/ftp-sync.js)
.ftp-sync.json
.ftp-sync-diff.json
.ftp-sync-diff.html

# Production build artifact (scripts/build.js) — per-build hashed filenames + symlinks, not
# meant to be versioned; regenerate with `npm run build`.
/dist/

# Tailwind output — fully derived from web/css/tailwind.css; regenerated by `npm start`
# (--watch) and by scripts/build.js itself (via `npm run build:css`) before every build.
/web/css/tailwind.generated.css

