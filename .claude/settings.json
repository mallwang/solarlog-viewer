{
  "permissions": {
    "deny": ["Read(.ftp-sync.json)", "Grep(.ftp-sync.json)"],
    "allow": [
      "Bash(grep -v -E '\\\\.\\(gif|jpg|ico|JPG\\)$')",
      "Bash(node --test *)",
      "Bash(npx eslint *)",
      "Bash(.specify/scripts/bash/setup-plan.sh --json)",
      "Bash(rtk git *)",
      "Bash(.specify/scripts/bash/setup-tasks.sh --json)",
      "Bash(.specify/extensions/git/scripts/bash/auto-commit.sh after_tasks)",
      "Bash(rtk grep *)",
      "Bash(rtk stat *)",
      "Bash(rtk read *)",
      "Bash(rtk wc *)",
      "Bash(rtk ls *)",
      "Bash(node scripts/* --help)",
      "Bash(rtk find *)"
    ]
  },
  "sandbox": {
    "credentials": {
      "files": [{ "path": ".ftp-sync.json", "mode": "deny" }]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash(git commit*)",
        "hooks": [
          {
            "type": "command",
            "command": "cd /home/z003f3jd/projects/github/solarlog-viewer && npm run format"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "if grep -Eqi \"(^|[^.[:alnum:]_-])\\.ftp-sync\\.json([^.[:alnum:]_-]|$)\"; then printf %s '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Blocked: this Bash command references .ftp-sync.json (contains an FTP password). Reading or writing it via Bash -- including through wrappers like rtk proxy, cat, head/tail/sed/awk, or similar -- is not allowed. Use the sync-ftp skill, or ask the user directly.\"}}'; else printf %s '{}'; fi"
          }
        ]
      }
    ]
  }
}
