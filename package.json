{
  "name": "solarlog-viewer",
  "version": "1.0.0",
  "description": "Static viewer for SolarLog data exports",
  "type": "module",
  "scripts": {
    "start": "browser-sync start --server --files '*.html, *.css, *.js, !min*.js, !base_vars.js, !days*.js, !months.js, !years.js, !daysall.js' --no-open",
    "open": "explorer.exe http://localhost:3000",
    "test": "playwright test",
    "test:scripts": "node --test scripts/*.test.js",
    "lint": "eslint --no-error-on-unmatched-pattern src tests",
    "format": "prettier --write --no-error-on-unmatched-pattern \"src/**/*.{js,css,html}\" \"tests/**/*.js\" \"docs/**/*.md\" \"specs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{js,css,html}\" \"tests/**/*.js\" \"docs/**/*.md\" \"specs/**/*.md\" \"*.md\"",
    "gap:detect": "node scripts/gap-detect.js",
    "gap:detect:days-history": "node scripts/gap-detect.js --source days_hist",
    "validate:plausibility": "node scripts/validate-plausibility.js",
    "fill:days-hist": "node scripts/fill-days-hist.js --dry-run",
    "fill:months": "node scripts/fill-months.js --dry-run",
    "fill:years": "node scripts/fill-years.js --dry-run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "browser-sync": "^3.0.4",
    "eslint": "^10.8.0",
    "prettier": "^3.9.6"
  }
}
