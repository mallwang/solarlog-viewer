{
  "name": "solarlog-viewer",
  "version": "1.0.0",
  "description": "Static viewer for SolarLog data exports",
  "type": "module",
  "scripts": {
    "start": "tailwindcss -i web/css/tailwind.css -o web/css/tailwind.generated.css --watch & browser-sync start --config bs-config.cjs",
    "build:css": "tailwindcss -i web/css/tailwind.css -o web/css/tailwind.generated.css --minify",
    "open": "explorer.exe http://localhost:3000",
    "test": "playwright test",
    "test:scripts": "node --test scripts/*.test.js \"web/js/**/*.test.js\"",
    "lint": "eslint --no-error-on-unmatched-pattern web tests",
    "format": "prettier --write --no-error-on-unmatched-pattern \"web/index.html\" \"web/css/**/*.css\" \"web/js/**/*.js\" \"tests/**/*.js\" \"docs/**/*.md\" \"specs/**/*.md\" \"*.md\"",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"web/index.html\" \"web/css/**/*.css\" \"web/js/**/*.js\" \"tests/**/*.js\" \"docs/**/*.md\" \"specs/**/*.md\" \"*.md\"",
    "gap:detect": "node scripts/gap-detect.js",
    "gap:detect:days-history": "node scripts/gap-detect.js --source days_hist",
    "validate:plausibility": "node scripts/validate-plausibility.js",
    "validate:min-consistency": "node scripts/validate-min-consistency.js",
    "fill:days-hist": "node scripts/fill-days-hist.js --dry-run",
    "fill:months": "node scripts/fill-months.js --dry-run",
    "fill:years": "node scripts/fill-years.js --dry-run",
    "sync:sqlite": "node scripts/sync-sqlite.js",
    "ftp:diff": "node scripts/ftp-sync.js --diff",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/cli": "^4.1.0",
    "basic-ftp": "^6.2.0",
    "browser-sync": "^3.0.4",
    "eslint": "^10.8.0",
    "http-proxy-middleware": "^4.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.1.0"
  }
}
